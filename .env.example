# POSTGRES CONFIG (DON'T USE QUOTES)
PG_USERNAME=YOUR_USERNAME
PG_PASSWORD=YOUR_PASSWORD
PG_DBNAME=YOUR_DBNAME
PG_CONNECTIONSTRING_MODEL=jdbc:postgresql://[DB_SERVER]:[DB_PORT]/[DB_NAME]

JWT_SECRET_KEY=YOUR_KEY
# Recommends use False for developing and True for production
SEND_EMAIL=false

# Maileroo Configs (NOT NECESSERY IF SEND_EMAIL IS FALSE)
SMTP_HOST=YOUR_SMTP_EMAIL
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_SENDING_KEY=YOUR_SENDING_KEY